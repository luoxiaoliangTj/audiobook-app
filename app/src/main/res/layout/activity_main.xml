<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A">

    <!-- Main content area (fills entire screen) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Legacy scroll view (kept for backward compatibility) -->
    <ScrollView android:id="@+id/scrollContent" android:layout_width="match_parent"
        android:layout_height="match_parent" android:fillViewport="true"
        android:visibility="gone">

        <TextView android:id="@+id/textContent" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:padding="24dp"
            android:textSize="18sp" android:lineSpacingMultiplier="1.8"
            android:textIsSelectable="true" android:typeface="serif" />

    </ScrollView>

    <!-- Debug panel -->
    <EditText android:id="@+id/debugPanel" android:layout_width="match_parent"
        android:layout_height="match_parent" android:visibility="gone"
        android:gravity="top|start" android:background="#2D2D2D"
        android:textColor="#CCC" android:textSize="11sp"
        android:fontFamily="monospace" android:focusable="true"
        android:inputType="textNoSuggestions" android:cursorVisible="false"
        android:longClickable="true" android:scrollbars="vertical" />

    <!-- PDF Page Display (for image-based PDFs) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pdfViewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Floating OCR Button -->
    <Button android:id="@+id/btnOcr" android:layout_width="56dp"
        android:layout_height="56dp" android:layout_gravity="bottom|end"
        android:layout_margin="16dp" android:text="OCR"
        android:textSize="12sp" android:minHeight="56dp"
        android:background="@android:drawable/dialog_holo_light_frame"
        android:visibility="gone" />

    <!-- Top toolbar (overlay) -->
    <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:background="#2D2D2D" android:padding="4dp"
        android:layout_gravity="top"
        android:visibility="gone">

        <Button android:id="@+id/btnBookshelf" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="书架" android:textSize="12sp" android:minHeight="36dp" />

        <Button android:id="@+id/btnSelectFile" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="文件" android:textSize="12sp" android:minHeight="36dp" />

        <Button android:id="@+id/btnVoice" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="声音" android:textSize="12sp" android:minHeight="36dp" />

        <Button android:id="@+id/btnTheme" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="主题" android:textSize="12sp" android:minHeight="36dp" />

        <Button android:id="@+id/btnMore" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="更多 ▾" android:textSize="12sp" android:minHeight="36dp" />

    </LinearLayout>

    <!-- Bottom control bar (overlay) -->
    <LinearLayout android:id="@+id/bottomBar" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:background="#2D2D2D" android:padding="4dp"
        android:layout_gravity="bottom"
        android:visibility="gone">

        <Button android:id="@+id/btnPrevChapter" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="◀" android:textSize="14sp" android:minHeight="36dp" />

        <Button android:id="@+id/btnJumpTo" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="跳转" android:textSize="12sp" android:minHeight="36dp" />

        <Button android:id="@+id/btnPlay" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="▶" android:textSize="14sp" android:minHeight="36dp" />

        <Button android:id="@+id/btnPause" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="⏸" android:textSize="14sp" android:minHeight="36dp" />

        <Button android:id="@+id/btnReplay" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="⏮" android:textSize="14sp" android:minHeight="36dp" />

        <Button android:id="@+id/btnNextChapter" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="▶|" android:textSize="14sp" android:minHeight="36dp" />

    </LinearLayout>

</FrameLayout>

